generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  fullName     String    @map("full_name")
  passwordHash String?   @map("password_hash")
  status       String    @default("active")
  theme        String    @default("sage")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  memberships  OrgMember[]
  @@map("users")
}

model Organization {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  email      String
  currency   String   @default("USD")
  theme      String   @default("sage")
  plan       String   @default("starter")
  planStatus String   @default("trial") @map("plan_status")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  members    OrgMember[]
  sequences  Sequence[]
  contacts   Contact[]
  invoices   Invoice[]
  accounts   Account[]
  bankAccounts BankAccount[]
  expenses   Expense[]
  bills      Bill[]
  budgets    Budget[]
  @@map("organizations")
}

model OrgMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([orgId, userId])
  @@map("org_members")
}

model Sequence {
  orgId   String @map("org_id") @db.Uuid
  name    String
  prefix  String @default("")
  nextVal Int    @default(1) @map("next_val")
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@id([orgId, name])
  @@map("sequences")
}

model Contact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  email     String?
  type      String   @default("customer")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  @@map("contacts")
}

model Account {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  code          String
  name          String
  type          String
  subtype       String?
  normalBalance String   @map("normal_balance")
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@unique([orgId, code])
  @@map("accounts")
}

model Invoice {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  contactId     String   @map("contact_id") @db.Uuid
  invoiceNumber String   @map("invoice_number")
  status        String   @default("draft")
  issueDate     DateTime @map("issue_date")
  dueDate       DateTime @map("due_date")
  currency      String   @default("USD")
  subtotal      Decimal  @default(0) @db.Decimal(15,2)
  taxAmount     Decimal  @default(0) @map("tax_amount") @db.Decimal(15,2)
  total         Decimal  @default(0) @db.Decimal(15,2)
  amountPaid    Decimal  @default(0) @map("amount_paid") @db.Decimal(15,2)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact       Contact @relation(fields: [contactId], references: [id])
  @@map("invoices")
}

model BankAccount {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  name            String
  institutionName String?  @map("institution_name")
  accountType     String   @default("depository") @map("account_type")
  mask            String?
  currency        String   @default("USD")
  currentBalance  Decimal  @default(0) @map("current_balance") @db.Decimal(15,2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@map("bank_accounts")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  vendor      String
  category    String   @default("Other")
  amount      Decimal  @db.Decimal(15,2)
  date        DateTime @default(now())
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@map("expenses")
}

model Bill {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  vendor      String
  amount      Decimal  @db.Decimal(15,2)
  dueDate     DateTime @map("due_date")
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@map("bills")
}

model Budget {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  amount    Decimal  @db.Decimal(15,2)
  spent     Decimal  @default(0) @db.Decimal(15,2)
  period    String   @default("monthly")
  category  String   @default("General")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  @@map("budgets")
}
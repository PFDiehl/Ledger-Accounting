# Copy to .env and fill in your values
# Never commit .env to source control

# ── Database ───────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ledger_dev"

# ── Server ─────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Auth ───────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Redis (for sessions + job queue) ───────────
REDIS_URL=redis://localhost:6379

# ── Email (Nodemailer) ─────────────────────────
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=your-postmark-api-token
SMTP_PASS=your-postmark-api-token
EMAIL_FROM="Ledger <noreply@yourapp.com>"

# ── File Storage (S3-compatible) ───────────────
S3_BUCKET=ledger-attachments
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Plaid (bank feeds) ─────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Plaid (bank feeds) ─────────────────────────────────────────────────────────
# Get credentials at https://dashboard.plaid.com/
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox   # sandbox | development | production

# ── Ethereal (dev email preview — auto-used when SMTP_HOST is unset) ──────────
# Sign up at https://ethereal.email/ to get a preview inbox
# Leave blank to use auto-generated Ethereal credentials
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ledger <noreply@ledger.dev>"

# ── Stripe (customer portal payments) ─────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Open Exchange Rates (multi-currency) ──────────────────
OPENEXCHANGERATES_APP_ID=

# ── AWS (S3 + Textract for document storage + OCR) ────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET=ledger-attachments

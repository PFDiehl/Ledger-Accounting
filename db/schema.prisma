// Prisma schema — mirrors the SQL schema for Node.js use
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────

enum UserStatus       { active inactive invited }
enum OrgRole          { owner admin accountant member viewer }
enum AccountType      { asset liability equity revenue expense }
enum JournalStatus    { draft posted void }
enum JournalSource    { manual invoice bill payment bank_import payroll adjustment }
enum InvoiceStatus    { draft sent partial paid overdue void }
enum BillStatus       { draft pending partial paid overdue void }
enum PaymentType      { incoming outgoing }
enum PaymentMethod    { bank_transfer check credit_card cash stripe paypal other }
enum TxnStatus        { unreviewed categorized reconciled excluded }
enum EmployeeStatus   { active inactive terminated }
enum PayType          { salary hourly }
enum PayFrequency     { weekly biweekly semimonthly monthly }
enum PayRunStatus     { draft approved processed void }
enum ContactType      { customer vendor both }

// ── Models ────────────────────────────────────

model Organization {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  slug            String    @unique
  email           String
  phone           String?
  currency        String    @default("USD") @db.Char(3)
  fiscalYearEnd   Int       @default(12) @map("fiscal_year_end")
  timezone        String    @default("America/New_York")
  logoUrl         String?   @map("logo_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  members         OrgMember[]
  accounts        Account[]
  contacts        Contact[]
  invoices        Invoice[]
  bills           Bill[]
  payments        Payment[]
  journalEntries  JournalEntry[]
  bankAccounts    BankAccount[]
  employees       Employee[]
  taxRates        TaxRate[]
  sequences       Sequence[]

  @@map("organizations")
}

model User {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String      @unique
  fullName     String      @map("full_name")
  avatarUrl    String?     @map("avatar_url")
  passwordHash String?     @map("password_hash")
  status       UserStatus  @default(active)
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  memberships  OrgMember[]

  @@map("users")
}

model OrgMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     OrgRole  @default(member)
  joinedAt DateTime @default(now()) @map("joined_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model Account {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  parentId      String?     @map("parent_id") @db.Uuid
  code          String
  name          String
  type          AccountType
  description   String?
  isActive      Boolean     @default(true) @map("is_active")
  isSystem      Boolean     @default(false) @map("is_system")
  normalBalance String      @map("normal_balance")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@unique([orgId, code])
  @@map("accounts")
}

model JournalEntry {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  entryNumber  String        @map("entry_number")
  date         DateTime      @db.Date
  description  String
  source       JournalSource @default(manual)
  sourceId     String?       @map("source_id") @db.Uuid
  status       JournalStatus @default(draft)
  createdById  String        @map("created_by") @db.Uuid
  postedAt     DateTime?     @map("posted_at")
  voidReason   String?       @map("void_reason")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  org   Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines JournalLine[]

  @@unique([orgId, entryNumber])
  @@map("journal_entries")
}

model JournalLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String  @map("entry_id") @db.Uuid
  accountId   String  @map("account_id") @db.Uuid
  description String?
  debit       Decimal @default(0) @db.Decimal(15, 2)
  credit      Decimal @default(0) @db.Decimal(15, 2)

  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

model Contact {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  type          ContactType @default(customer)
  name          String
  email         String?
  phone         String?
  paymentTerms  Int         @default(30) @map("payment_terms")
  currency      String      @default("USD") @db.Char(3)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  bills    Bill[]

  @@map("contacts")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String        @map("org_id") @db.Uuid
  contactId      String        @map("contact_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number")
  status         InvoiceStatus @default(draft)
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  currency       String        @default("USD") @db.Char(3)
  subtotal       Decimal       @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  total          Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(15, 2)
  notes          String?
  sentAt         DateTime?     @map("sent_at")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  org       Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  contact   Contact             @relation(fields: [contactId], references: [id])
  lineItems InvoiceLineItem[]

  @@unique([orgId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(15, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

model TaxRate {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String  @map("org_id") @db.Uuid
  name      String
  rate      Decimal @db.Decimal(6, 4)
  isActive  Boolean @default(true) @map("is_active")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@map("tax_rates")
}

model BankAccount {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId             String    @map("org_id") @db.Uuid
  ledgerAccountId   String    @map("ledger_account_id") @db.Uuid
  name              String
  institutionName   String?   @map("institution_name")
  mask              String?   @db.Char(4)
  currency          String    @default("USD") @db.Char(3)
  currentBalance    Decimal?  @map("current_balance") @db.Decimal(15, 2)
  lastSyncedAt      DateTime? @map("last_synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@map("bank_accounts")
}

model BankTransaction {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  bankAccountId  String    @map("bank_account_id") @db.Uuid
  date           DateTime  @db.Date
  description    String
  amount         Decimal   @db.Decimal(15, 2)
  status         TxnStatus @default(unreviewed)
  plaidTxnId     String?   @unique @map("plaid_txn_id")
  merchantName   String?   @map("merchant_name")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("bank_transactions")
}

model Sequence {
  orgId   String @map("org_id") @db.Uuid
  name    String
  prefix  String @default("")
  nextVal Int    @default(1) @map("next_val")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, name])
  @@map("sequences")
}
